{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend",
  "main": "worker.py",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": [
    "python_workers",
    "python_dedicated_snapshot"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "todo-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}